# Copy these into Vercel → Project → Settings → Environment Variables

# From sanity.io/manage → your project (the "Project ID")
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Leave as "production" unless you changed it
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: lets the contact form save enquiries into your dashboard.
# sanity.io/manage → your project → API → Tokens → Add API token (Editor permissions)
SANITY_API_WRITE_TOKEN=

# Optional: email notification for each new enquiry (free account at resend.com → API Keys)
RESEND_API_KEY=
# Where notifications go (defaults to contact@louisoliver.co.uk)
NOTIFY_EMAIL=contact@louisoliver.co.uk
# Sender, once louisoliver.co.uk is verified in Resend, use e.g. Louis Oliver Website <website@louisoliver.co.uk>
NOTIFY_FROM=
# Your live address, used for the "Open dashboard" button (e.g. https://louisoliver.co.uk)
SITE_URL=
